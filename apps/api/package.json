{
  "name": "@healthos/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@healthos/types": "*",
    "@healthos/shared": "*",
    "@anthropic-ai/sdk": "^0.21.0",
    "fastify": "^4.25.0",
    "fastify-cors": "^6.1.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/jwt": "^7.0.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "dotenv": "^16.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "*",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "eslint": "^8.55.0",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0"
  }
}
