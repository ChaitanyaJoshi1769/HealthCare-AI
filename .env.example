# HealthOS Environment Configuration
# Copy this file to .env and update with your values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0
ENABLE_LOGGING=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://healthos:healthos_dev@localhost:5432/healthos
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=healthos_dev_password

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phase 2: Genomics External Services
# ClinVar API
CLINVAR_API_URL=https://api.clinvar.ncbi.nlm.nih.gov/
CLINVAR_API_KEY=optional_api_key

# gnomAD API
GNOMAD_API_URL=https://gnomad.broadinstitute.org/api
GNOMAD_API_KEY=optional_api_key

# PharmGKB
PHARMGKB_API_URL=https://api.pharmgkb.org/
PHARMGKB_API_KEY=your_pharmgkb_api_key

# NCBI / PubMed
NCBI_API_KEY=your_ncbi_api_key
PUBMED_BASE_URL=https://pubmed.ncbi.nlm.nih.gov/

# Phase 3: Therapeutic Design
# AlphaFold
ALPHAFOLD_SERVER_URL=https://alphafold-server.example.com
ALPHAFOLD_API_KEY=your_alphafold_api_key

# Phase 4: Enterprise - EHR Integration
# Epic Integration
EPIC_ENDPOINT=https://epic-fhir.example.com/
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_client_secret

# Cerner Integration
CERNER_ENDPOINT=https://cerner-fhir.example.com/
CERNER_CLIENT_ID=your_cerner_client_id
CERNER_CLIENT_SECRET=your_cerner_client_secret

# Athenahealth Integration
ATHENAHEALTH_ENDPOINT=https://athenahealth-fhir.example.com/
ATHENAHEALTH_CLIENT_ID=your_athenahealth_client_id
ATHENAHEALTH_CLIENT_SECRET=your_athenahealth_client_secret

# Generic FHIR Server
FHIR_SERVER_URL=https://fhir-server.example.com/
FHIR_SERVER_AUTH_TYPE=oauth2
FHIR_API_KEY=your_fhir_api_key

# Encryption
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# S3 Bucket for Genomic Files
GENOMICS_S3_BUCKET=healthos-genomics
GENOMICS_S3_REGION=us-east-1

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@healthos.example.com
SMTP_PASSWORD=your_smtp_password

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
CORS_ORIGIN=http://localhost:3001,https://healthos.example.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Multi-tenancy
ENABLE_MULTI_TENANCY=true
DEFAULT_TENANT_ID=default

# Federated Learning
FL_PRIVACY_EPSILON=8.0
FL_PRIVACY_DELTA=0.00001

# Feature Flags
ENABLE_GENOMICS=true
ENABLE_THERAPEUTIC_DESIGN=true
ENABLE_ENTERPRISE=true
ENABLE_FEDERATED_LEARNING=true
ENABLE_CDS_HOOKS=true
